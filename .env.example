# Copy to .env. The system runs fully without any of these — replies become
# extractive and the judge runs a deterministic rubric, both clearly labelled.

# ---- Provider chain -------------------------------------------------------
# Comma-separated, tried in order, failing over only on retryable errors
# (429 / 5xx / timeout). Valid names: ollama, gemini, openai_compat
LLM_PROVIDER_ORDER=ollama,gemini

# Judge on a DIFFERENT chain than the drafter, so the grader is not grading its
# own output (Panickssery et al., NeurIPS 2024). Leave blank to share the chain.
JUDGE_PROVIDER_ORDER=gemini,ollama

# ---- Ollama (local, no quota) ---------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# ---- Gemini (cloud) -------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey — never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Any OpenAI-compatible endpoint (NVIDIA NIM, vLLM, Together, OpenAI) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Misc -----------------------------------------------------------------
LLM_TIMEOUT=90
BRAND=SpotifyCares
MAX_PAIRS=20000
