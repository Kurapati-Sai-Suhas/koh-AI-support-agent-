# Copy to .env. Everything runs without these; the LLM parts upgrade when set.
#
# OpenAI-compatible endpoint. Verified shapes:
#   NVIDIA NIM  https://integrate.api.nvidia.com/v1   (free tier at build.nvidia.com)
#   OpenAI      https://api.openai.com/v1
#   local vLLM  http://localhost:8000/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-70b-instruct

# Use a DIFFERENT model here than LLM_MODEL. If the drafter also judges, the
# judge scores are inflated by self-preference bias (Panickssery et al., 2024).
JUDGE_MODEL=

# Optional overrides
BRAND=SpotifyCares
MAX_PAIRS=20000
